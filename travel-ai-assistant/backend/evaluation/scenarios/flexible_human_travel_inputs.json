  {
    "id": "flexible_clear_flight_birmingham_paris_dates",
    "description": "Clear natural-language flight request with explicit origin, destination, and dates.",
    "initial_state": {
      "default_origin": {
        "city": "East Midlands",
        "country": "United Kingdom",
        "airportCode": "EMA",
        "airportName": "East Midlands Airport",
        "source": "evaluation_default_origin"
      }
    },
    "turns": [
      {
        "user_message": "I need a flight from Birmingham to Paris from 12 September to 16 September",
        "mocked_llama_output": {
          "tool": "prepare_trip_request",
          "arguments": {
            "requested_product": "flight",
            "intent": "flight_search",
            "origin_text": "Birmingham",
            "origin_code": "BHX",
            "destination_text": "Paris",
            "destination_type": "city",
            "destination_code": "CDG",
            "departure_date": "2026-09-12",
            "return_date": "2026-09-16",
            "missing_fields": [],
            "use_active_trip_state": false
          }
        },
        "expected_tool": "prepare_trip_request",
        "expected_active_state": {
          "origin.airportCode": "BHX",
          "selectedDestination.airportCode": "CDG",
          "dates.departureDate": "2026-09-12",
          "dates.returnDate": "2026-09-16",
          "latestVisibleResultType": "flights"
        },
        "expected_provider_calls": [
          {
            "type": "flights",
            "origin": "BHX",
            "destination": "CDG",
            "departureDate": "2026-09-12",
            "returnDate": "2026-09-16"
          }
        ],
        "expected_response_contains": [
          "flight options",
          "BHX to CDG"
        ],
        "forbidden_response_text": [
          "LHR to LHR",
          "Please provide your exact departure"
        ]
      }
    ]
  },
