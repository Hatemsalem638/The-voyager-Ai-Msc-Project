  {
    "id": "affirmative_after_destination_discovery_offer_executes_discovery",
    "description": "An affirmative after a destination-discovery offer should execute the pending destination search, not select a flight.",
    "initial_state": {
      "default_origin": {
        "city": "East Midlands",
        "country": "United Kingdom",
        "airportCode": "EMA",
        "airportName": "East Midlands Airport",
        "source": "evaluation_default_origin"
      }
    },
    "turns": [
      {
        "user_message": "18th of september from my location",
        "mocked_llama_output": {
          "tool": "prepare_trip_request",
          "arguments": {
            "requested_product": "flight",
            "intent": "destination_discovery",
            "destination_text": null,
            "destination_type": "unknown",
            "origin_text": "East Midlands Airport",
            "origin_code": "EMA",
            "requiredActivities": ["beach"],
            "environmentPreferences": ["beach"],
            "departure_date": "2026-09-18",
            "missing_fields": [],
            "use_active_trip_state": true
          }
        },
        "expected_tool": "prepare_trip_request",
        "expected_active_state": {
          "origin.airportCode": "EMA",
          "dates.departureDate": "2026-09-18",
          "pendingAction.type": "suggest_destinations",
          "latestVisibleResultType": "destination_discovery_pending"
        },
        "expected_pendingAction": {
          "type": "suggest_destinations",
          "origin": "EMA",
          "departureDate": "2026-09-18"
        },
        "expected_response_contains": ["I can search beach destinations"],
        "forbidden_provider_calls": ["flights"]
      },
      {
        "user_message": "yes please",
        "mocked_llama_output": {
          "tool": "select_flight",
          "arguments": {
            "selection": "current",
            "use_active_trip_state": true
          }
        },
        "expected_tool": "select_flight",
        "expected_active_state": {
          "latestVisibleResultType": "destinations",
          "pendingAction": null
        },
        "expected_provider_calls": [
          {
            "type": "destinations",
            "origin": "EMA",
            "departureDate": "2026-09-18"
          }
        ],
        "expected_response_contains": ["destination ideas"],
        "forbidden_response_text": ["Please choose a flight option first"]
      }
    ]
  }
