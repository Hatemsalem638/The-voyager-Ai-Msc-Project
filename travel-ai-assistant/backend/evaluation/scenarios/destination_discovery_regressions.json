[
  {
    "id": "confirmed_destination_not_widened_by_date_only_region",
    "description": "A confirmed destination selected from discovery results must not be widened back to its country on a date-only follow-up.",
    "initial_state": {
      "active_trip": {
        "revision": 8,
        "origin": {
          "city": "Birmingham",
          "country": "United Kingdom",
          "airportCode": "BHX",
          "airportName": "Birmingham Airport",
          "source": "explicit_origin"
        },
        "selectedDestination": {
          "city": "Hurghada",
          "country": "Egypt",
          "airportCode": "HRG",
          "airportName": "Hurghada International Airport",
          "source": "selected_recommendation",
          "recommendationId": "HRG:1",
          "confirmed": true
        },
        "destinationRegion": null,
        "destinationCandidates": [],
        "dates": {
          "departureDate": null,
          "returnDate": null,
          "source": "destination_selected"
        },
        "requestedProducts": ["flights"],
        "pendingTripRequest": {
          "intent": "flight_search",
          "missingFields": ["departure_date", "return_date"]
        },
        "latestVisibleResultType": "trip_clarification",
        "status": "destination_selected"
      }
    },
    "turns": [
      {
        "user_message": "18th of september and return 25th of september",
        "mocked_llama_output": {
          "tool": "prepare_trip_request",
          "arguments": {
            "requested_product": "flight",
            "intent": "flight_search",
            "destination_text": "Egypt",
            "destination_region": "Egypt",
            "destination_type": "country",
            "destination_candidates": ["HRG", "SSH"],
            "departure_date": "2026-09-18",
            "return_date": "2026-09-25",
            "missing_fields": [],
            "use_active_trip_state": false
          }
        },
        "expected_tool": "prepare_trip_request",
        "expected_active_state": {
          "origin.airportCode": "BHX",
          "selectedDestination.airportCode": "HRG",
          "destinationRegion": null,
          "dates.departureDate": "2026-09-18",
          "dates.returnDate": "2026-09-25"
        },
        "expected_provider_calls": [
          {
            "type": "flights",
            "origin": "BHX",
            "destination": "HRG",
            "departureDate": "2026-09-18",
            "returnDate": "2026-09-25"
          }
        ],
        "forbidden_response_text": [" to Egypt", "Please provide your exact departure"]
      }
    ]
  },
